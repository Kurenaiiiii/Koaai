{
    "_comment": "Koaai — everything (bot + yt-dlp nightly + Node 22) is baked into the Docker image. No uploads, no install downloads. Secrets come from variables below, never from the image.",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-09-04T00:00:00+00:00",
    "name": "Koaai",
    "author": "kurenai@koaai.dev",
    "description": "Koaai - single-process Rust Discord music bot. Image already contains koaai + yt-dlp + Node. Just set the token and start.",
    "features": null,
    "docker_images": {
        "ghcr.io/kurenaiiiii/koaai:latest": "ghcr.io/kurenaiiiii/koaai:latest"
    },
    "file_denylist": [],
    "startup": "cd /home/container && exec /app/koaai",
    "config": {
        "files": "{}",
        "startup": "{\r\n    \"done\": [\r\n        \"ready as\"\r\n    ]\r\n}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\r\n# Nothing to install — the server image already has koaai + yt-dlp + node.\r\n# (This runs in the installer container, not the server image, so there is\r\n# nothing to verify here. Secrets come from the variables below.)\r\necho \"koaai image ready — set your variables and press Start\"\r\nexit 0",
            "container": "ghcr.io/ptero-eggs/installers:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Bot Token",
            "description": "Discord bot token.",
            "env_variable": "TOKEN",
            "default_value": "",
            "user_viewable": false,
            "user_editable": true,
            "rules": "required|string",
            "field_type": "text"
        },
        {
            "name": "Owner ID",
            "description": "Your Discord user ID - unlocks the report dashboard in DMs.",
            "env_variable": "OWNER_ID",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string",
            "field_type": "text"
        },
        {
            "name": "Dev Guild ID",
            "description": "Scope slash-command registration to one guild while testing. Leave empty for global registration.",
            "env_variable": "DEV_GUILD_ID",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string",
            "field_type": "text"
        },
        {
            "name": "Spotify Client ID",
            "description": "Enables Spotify links and spsearch.",
            "env_variable": "SPOTIFY_CLIENT_ID",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string",
            "field_type": "text"
        },
        {
            "name": "Spotify Client Secret",
            "description": "Spotify OAuth secret.",
            "env_variable": "SPOTIFY_CLIENT_SECRET",
            "default_value": "",
            "user_viewable": false,
            "user_editable": true,
            "rules": "nullable|string",
            "field_type": "text"
        }
    ]
}
